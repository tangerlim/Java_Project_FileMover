{
  "watchDir": "C:\\Users\\likgr\\Downloads",
  "baseDir": "C:\\Users\\likgr\\Desktop\\--",
  "rules": [
    {
      "name": "WebServerProgram",
      "match": {
        "namePattern": "^(?=.*lab)\\D*(\\d+)(?=.*\\.)"
      },
      "target": "WebServerProgram",
      "rename": "lab{1}.{ext}"
    },
    {
      "name": "데이터통신",
      "match": {
        "namePattern": "(?<![a-z])ch(\\d+)"
      },
      "target": "데이터통신",
      "rename": "ch_{1}.{ext}"
    },
    {
      "name": "고웹프",
      "match": {
        "namePattern": "(\\d+)\\s*주차.*수업자료"
      },
      "target": "고웹프",
      "rename": "react_{1}.{ext}"
    },
    {
      "name": "Java",
      "match": {
        "glob": "*주차*강의자료*"
      },
      "target": "Java"
    }
  ]
}
